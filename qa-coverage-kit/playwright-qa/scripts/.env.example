# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials. Agents are blocked from reading it.

BASE_URL=https://test.example.com
QA_EMAIL=your-qa-account@example.com
QA_PASSWORD=your-qa-password

# Minutes a saved login is reused before auth.setup.ts signs in again.
# Set it to (session lifetime − longest run), e.g. 30-minute sessions and a 15-minute run → 15.
AUTH_REUSE_MINUTES=10
